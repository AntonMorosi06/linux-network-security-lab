# Lab 030 Fail2ban jail dry-run example
# DO NOT COPY INTO /etc/fail2ban WITHOUT REVIEW.
# This is documentation-only.

[lab-auth-synthetic]
enabled = false
filter = lab-auth
logpath = /path/to/linux-network-security-lab/data/lab030/synthetic_auth.log
maxretry = 3
findtime = 600
bantime = 300
action = %(action_)s
