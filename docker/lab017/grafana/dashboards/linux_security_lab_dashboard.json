{
  "id": null,
  "uid": "linux-security-lab017",
  "title": "Linux Security Lab — Lab 017",
  "tags": ["linux", "security", "prometheus", "local-lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "API Target Up",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "up{job=\"lab017_observable_api\"}", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Total Requests",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "lab017_requests_total", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Total Errors",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "lab017_error_requests_total", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Total 404",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "lab017_not_found_total", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Request Rate",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "rate(lab017_requests_total[1m])", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Error and 404 Counters",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "lab017_error_requests_total", "refId": "A", "legendFormat": "errors"},
        {"expr": "lab017_not_found_total", "refId": "B", "legendFormat": "not_found"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Uptime Seconds",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "targets": [{"expr": "lab017_uptime_seconds", "refId": "A"}]
    }
  ]
